# NutriGuide AI Environment Configuration
# Copy this file to .env and fill in your values

# ─── Gemini AI ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── USDA FoodData Central ──────────────────────────────────────────────────
# Get your free key at: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your_usda_api_key_here

# ─── Open Food Facts ────────────────────────────────────────────────────────
# No API key required for basic usage - it's a free open database
# Optional: set your app name for user agent
OPENFOODFACTS_USER_AGENT=NutriGuideAI/1.0

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# ─── Frontend ───────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ─── Model Configuration ────────────────────────────────────────────────────
# Path to fine-tuned model weights (optional - uses ImageNet pretrained if not set)
MODEL_WEIGHTS_PATH=models/nutriguide_classifier.pth

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
